# Credentials for the compose stack. The application builds URLs from these parts,
# so do not duplicate DATABASE_URL / CELERY_BROKER_URL here.
POSTGRES_USER=devdocs
POSTGRES_PASSWORD=devdocs
POSTGRES_DB=devdocs

RABBITMQ_USER=devdocs
RABBITMQ_PASSWORD=devdocs

# Embeddings. Changing EMBEDDING_DIM requires a migration and a reindex.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32

# Chunking and search
CHUNK_MAX_TOKENS=600
SEARCH_TOP_K=5
SEARCH_MAX_TOP_K=20
SEARCH_CANDIDATES=30
RRF_K=60
CACHE_TTL_SECONDS=3600

# Ingestion
KNOWLEDGE_DIR=knowledge
GIT_CLONE_TIMEOUT_SECONDS=300
INGESTION_MAX_RETRIES=3
